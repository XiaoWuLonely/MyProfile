{
  "name": "paper-and-pixels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint src astro.config.mjs eslint.config.js",
    "format": "prettier --write src astro.config.mjs eslint.config.js package.json tsconfig.json",
    "format:check": "prettier --check src astro.config.mjs eslint.config.js package.json tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "astro": "7.4.5",
    "gsap": "3.15.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/three": "~0.187.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
