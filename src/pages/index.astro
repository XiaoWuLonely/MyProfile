---
import { Image } from 'astro:assets';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '../styles/global.css';
import '../styles/story.css';
import StoryProjects from '../components/StoryProjects.astro';
import plant from '../assets/botanical-cutout.png';
const chapters = [
  ['works', '作品'],
  ['about', '关于'],
  ['journey', '经历'],
  ['contact', '联系'],
];
const years = [
  ['2023', '从好奇开始', '广东理工职业学院 · 电子商务', '2023—2025'],
  [
    '2024',
    '把学习，留在纸上',
    '记录技术笔记、资源链接与项目想法。',
    '学习与记录',
  ],
  [
    '2025',
    '走进计算机的世界',
    '广东白云学院 · 计算机科学与技术',
    '本科 · 2025—2027',
  ],
  [
    '2026',
    '让想法慢慢落地',
    '个人博客、AI 知识库与团队项目实践。',
    '继续探索中',
  ],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="邓林峰 WuLong 的个人作品集。沿一条纸路，翻阅作品、学习与持续生长的故事。"
    />
    <meta name="theme-color" content="#f5eddf" />
    <meta property="og:title" content="邓林峰 WuLong · Paper & Pixels" />
    <meta property="og:description" content="一段会呼吸的纸造旅程。" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" />
    <title>邓林峰 WuLong · Paper &amp; Pixels</title>
  </head>
  <body>
    <a class="skip-link" href="?reading=1#main">
      跳过动画，阅读内容
    </a>
    <header class="site-header">
      <a class="wordmark" href="#home" aria-label="Paper and Pixels，返回首页">
        <span class="brand-seed" aria-hidden="true">
          ✳
        </span>
        Paper <i>&amp;</i> Pixels<span class="wordmark-dot">.</span>
      </a>
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        目录 ＋
      </button>
      <nav id="site-nav" class="site-nav" aria-label="章节导航">
        {chapters.map(([id, label], i) => (
          <a href={`#${id}`}>
            <span>0{i + 1}</span>
            {label}
          </a>
        ))}
      </nav>
      <a class="resume-link" href="/resume-deng-linfeng.pdf" download>
        简历 ↓
      </a>
    </header>
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main id="main">
          <div id="story-stage" aria-label="沿纸路展开的个人作品集">
            <div class="world-backdrop" aria-hidden="true">
              <div class="paper-terrain">
                <div class="paper-hill hill-far"></div>
                <div class="paper-hill hill-middle"></div>
                <div class="paper-hill hill-near"></div>
                <svg
                  class="paper-road"
                  viewBox="0 0 1440 600"
                  preserveAspectRatio="none"
                >
                  <path
                    class="road-shadow"
                    d="M800 620C440 460 1060 310 720 220S500 50 780-40"
                  />
                  <path d="M800 620C440 460 1060 310 720 220S500 50 780-40" />
                  <path
                    class="road-ink"
                    d="M800 620C440 460 1060 310 720 220S500 50 780-40"
                  />
                </svg>
              </div>
              <div id="world-canvas"></div>
            </div>
            <div class="field-plants" aria-hidden="true">
              {[0, 1, 2, 3].map((i) => (
                <div class={`field-plant plant-${i}`}>
                  <Image
                    src={plant}
                    alt=""
                    widths={[320, 640]}
                    sizes="(max-width:767px) 35vw, 24vw"
                    format="webp"
                    loading="eager"
                  />
                </div>
              ))}
            </div>
            <section
              class="story-panel opening-panel"
              id="home"
              data-story-panel
              aria-labelledby="hero-title"
            >
              <div class="opening-collage" aria-hidden="true">
                <div class="opening-sun" data-piece></div>
                <div class="opening-olive" data-piece></div>
                <div class="opening-sheet" data-board>
                  <svg class="opening-mark" viewBox="0 0 300 300">
                    <path d="M30 70L85 240L150 90L205 240L265 70M12 70H62M124 70H178M238 70H286" />
                  </svg>
                </div>
                <div class="opening-strip" data-piece></div>
              </div>
              <div class="scene-copy">
                <p class="eyebrow">
                  <span class="status-dot"></span> A GROWING PORTFOLIO / 2026
                </p>
                <p class="hero-intro">你好，我是邓林峰。</p>
                <h1 id="hero-title">
                  在逻辑与
                  <br />
                  想象之间。<em>WuLong.</em>
                </h1>
                <p class="project-poem">
                  学生开发者，也是一个始终保持好奇的人。
                </p>
                <p class="opening-note">把技术学深一点，把想法做得有趣一点。</p>
                <a class="text-link" href="#works">
                  沿着纸路，翻开作品 ↘
                </a>
              </div>
              <span class="scene-marginal" aria-hidden="true">
                A little logic.
                <br />
                <i>A little wonder.</i>
              </span>
            </section>
            <StoryProjects />
            <div class="story-bridge" aria-hidden="true">
              <svg viewBox="0 0 300 90">
                <path d="M10 62Q65 8 145 42T290 25" />
              </svg>
            </div>
            <section
              class="story-panel about-panel"
              id="about"
              data-story-panel
              aria-labelledby="about-title"
            >
              <div class="note-board" data-board>
                <span class="note-tape"></span>
                <p class="eyebrow">A NOTE TO MYSELF</p>
                <p class="handwritten-note">
                  Stay curious.
                  <br />
                  Keep growing.
                </p>
                <div class="skill-papers">
                  <span data-skill>Vue / React</span>
                  <span data-skill>TypeScript</span>
                  <span data-skill>Node.js</span>
                  <span data-skill>AI 应用</span>
                </div>
                <svg viewBox="0 0 400 80" class="note-line" aria-hidden="true">
                  <path data-draw d="M5 65Q90 5 180 40T390 20" />
                </svg>
              </div>
              <div class="chapter-copy">
                <p class="eyebrow">06 / A LITTLE ABOUT ME</p>
                <h2 id="about-title">
                  保持好奇，
                  <br />
                  也保持<span>笨拙的认真。</span>
                </h2>
                <p>
                  21 岁，计算机科学与技术在读。
                  <br />
                  从电子商务走进代码的世界，
                  <br />
                  喜欢让抽象的想法变成可以使用的东西。
                </p>
                <p>
                  向资深计算机开发工程师成长。
                  <br />
                  既打磨基础，也探索新技术的可能。
                </p>
                <a
                  class="text-link"
                  href="https://github.com/XiaoWuLonely"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  去 GitHub 看看我的日常 ↗
                </a>
              </div>
            </section>
            <section
              class="story-panel journey-panel"
              id="journey"
              data-story-panel
              aria-labelledby="journey-title"
            >
              <div class="chapter-copy">
                <p class="eyebrow">07 / NOTES ALONG THE WAY</p>
                <h2 id="journey-title">
                  没有捷径，
                  <br />
                  但沿途<span>有风景。</span>
                </h2>
              </div>
              <div class="journey-ribbon">
                <svg
                  viewBox="0 0 1200 240"
                  preserveAspectRatio="none"
                  class="growth-thread"
                  aria-hidden="true"
                >
                  <path
                    class="growth-guide"
                    d="M0 150C150 30 230 210 360 110S580 30 650 115S900 220 1200 70"
                  />
                  <path
                    data-draw
                    d="M0 150C150 30 230 210 360 110S580 30 650 115S900 220 1200 70"
                  />
                </svg>
                <ol>
                  {years.map(([year, title, body, period]) => (
                    <li class="year-note" data-year>
                      <span class="year">{year}</span>
                      <div class="year-paper">
                        <p class="eyebrow">{period}</p>
                        <h3>{title}</h3>
                        <p>{body}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
              <p class="journey-whisper">下一站，还在书写。 ↗</p>
            </section>
            <section
              class="story-panel contact-panel"
              id="contact"
              data-story-panel
              aria-labelledby="contact-title"
            >
              <div class="envelope-art" data-board aria-hidden="true">
                <div class="letter-paper">
                  <p>Say hello.</p>
                  <svg viewBox="0 0 300 40">
                    <path data-draw d="M5 20Q75 0 150 20T290 20" />
                  </svg>
                </div>
                <div class="envelope-pocket"></div>
                <div class="envelope-wing"></div>
                <span class="wax-seal">W</span>
              </div>
              <div class="chapter-copy">
                <p class="eyebrow">08 / LEAVE A LITTLE NOTE</p>
                <h2 id="contact-title">
                  下一段故事，
                  <br />
                  从一句<span>你好</span>开始。
                </h2>
                <p>
                  关于一个想法、一份机会，或只是打个招呼。
                  <br />
                  我的信箱，一直为新的连接留着位置。
                </p>
                <a class="contact-email" href="mailto:oolongheist@gmail.com">
                  oolongheist@gmail.com ↗
                </a>
                <div class="contact-actions">
                  <button class="text-link copy-email" type="button">
                    复制邮箱 ⧉
                  </button>
                  <a
                    class="text-link"
                    href="https://github.com/XiaoWuLonely"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    GitHub ↗
                  </a>
                  <a class="text-link" href="/resume-deng-linfeng.pdf" download>
                    下载简历 ↓
                  </a>
                </div>
                <p id="copy-status" role="status" aria-live="polite"></p>
              </div>
            </section>
          </div>
        </main>
        <footer class="story-footer">
          用代码构建，以好奇心生长。<span>© 2026 WULONG</span>
          <a href="#home">回到开头 ↑</a>
        </footer>
      </div>
    </div>
    <div class="reading-indicator">
      <span class="reading-current">开场原野</span>
      <span class="reading-line" aria-hidden="true">
        <span></span>
      </span>
      <span class="journey-hint">SCROLL TO WANDER ↓</span>
      <a class="reading-mode" href="?reading=1">
        无动画阅读
      </a>
    </div>
    <script>
      import { initializeStory } from '../scripts/story';
      import { initializeStoryUI } from '../scripts/story-ui';
      import { initializeWorld } from '../scripts/world-loader';
      const disposeUI = initializeStoryUI();
      const disposeStory = initializeStory();
      const disposeWorld = initializeWorld();
      if (import.meta.hot)
        import.meta.hot.dispose(() => {
          disposeWorld();
          disposeStory();
          disposeUI();
        });
    </script>
  </body>
</html>
