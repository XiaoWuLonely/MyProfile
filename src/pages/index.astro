---
import { Image } from 'astro:assets';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '../styles/global.css';
import '../styles/interactions.css';
import ProjectGallery from '../components/ProjectGallery.astro';
import Botanical from '../components/Botanical.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import hero from '../assets/home-hero.png';
import about from '../assets/about-art.png';
import contact from '../assets/contact-art.png';
const chapters = [
  ['works', '作品'],
  ['about', '关于'],
  ['journey', '经历'],
  ['contact', '联系'],
];
const journey = [
  {
    year: '2023',
    title: '从好奇开始',
    body: '广东理工职业学院 · 电子商务',
    period: '2023 — 2025',
  },
  {
    year: '2024',
    title: '把学习，留在纸上',
    body: '开始记录学习过程，把技术笔记、资源链接和项目想法逐步沉淀下来。',
    period: '学习与记录',
  },
  {
    year: '2025',
    title: '走进计算机的世界',
    body: '广东白云学院 · 计算机科学与技术',
    period: '本科 · 2025 — 2027',
  },
  {
    year: '2026',
    title: '让想法慢慢落地',
    body: '个人博客、AI 知识库、团队项目。在真实的构建中学习，也在协作中成长。',
    period: '继续探索中',
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="邓林峰 WuLong 的个人作品集。学生开发者，在逻辑与想象之间记录、构建、持续生长。"
    />
    <meta name="theme-color" content="#f5eddf" />
    <meta property="og:title" content="邓林峰 WuLong · Paper & Pixels" />
    <meta
      property="og:description"
      content="一本会呼吸的个人作品集。在纸张、代码与好奇心之间，持续生长。"
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>邓林峰 WuLong · Paper &amp; Pixels</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到内容
    </a>
    <header class="site-header">
      <a class="wordmark" href="#home" aria-label="Paper and Pixels，返回首页">
        <span class="brand-seed" aria-hidden="true">
          ✳
        </span>{' '}
        Paper <i>&amp;</i> Pixels<span class="wordmark-dot">.</span>
      </a>
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        目录 <span aria-hidden="true">＋</span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="章节导航">
        {chapters.map(([id, title], index) => (
          <a href={`#${id}`}>
            <span>0{index + 1}</span>
            {title}
          </a>
        ))}
      </nav>
      <a class="resume-link" href="/resume-deng-linfeng.pdf" download>
        简历 <span aria-hidden="true">↓</span>
      </a>
    </header>
    <main id="main">
      <section
        class="hero chapter"
        id="home"
        aria-labelledby="hero-title"
        data-chapter="开场"
      >
        <div class="hero-art" aria-hidden="true">
          <Image
            src={hero}
            alt=""
            widths={[780, 1440, 1920]}
            sizes="100vw"
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div id="paper-scene" class="paper-scene" aria-hidden="true"></div>
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow">
            <span class="status-dot"></span> A GROWING PORTFOLIO / 2026
          </p>
          <p class="hero-intro">你好，我是邓林峰。</p>
          <h1 id="hero-title">
            在逻辑与
            <br />
            <span class="hero-line">
              想象
              <span class="hand-circle">
                之间
                <svg viewBox="0 0 220 100" aria-hidden="true">
                  <path d="M202 23C155-5 41 1 15 40S46 104 132 91S234 36 191 15" />
                </svg>
              </span>
              。
            </span>
            <em>WuLong.</em>
          </h1>
          <p class="hero-description">
            学生开发者，也是一个始终保持好奇的人。
            <br />
            把技术学深一点，把想法做得有趣一点。
          </p>
          <a class="paper-button" href="#works">
            翻开我的作品 <span aria-hidden="true">↘</span>
          </a>
        </div>
        <div class="hero-side-note" aria-hidden="true">
          A little logic.
          <br />
          <i>A little wonder.</i>
        </div>
        <div class="hero-bottom">
          <span>代码 · 纸张 · 好奇心</span>
          <a href="#works">
            <span class="scroll-thread" aria-hidden="true"></span>向下，慢慢翻阅
          </a>
          <span class="hero-edition">VOL. 01 — ALWAYS GROWING</span>
        </div>
        <div class="torn-edge" aria-hidden="true"></div>
      </section>
      <ProjectGallery />
      <section
        id="about"
        class="chapter about"
        aria-labelledby="about-title"
        data-chapter="关于"
      >
        <div class="about-visual" data-reveal>
          <div class="about-art-paper">
            <Image
              src={about}
              alt="书本、植物与手工纸组成的暖色拼贴"
              widths={[500, 900]}
              sizes="(max-width: 760px) 90vw, 45vw"
              format="webp"
              quality={80}
            />
          </div>
          <span class="tape" aria-hidden="true"></span>
          <p class="handwritten">
            Still learning,
            <br />
            still growing.
          </p>
          <Botanical class="about-botanical" />
          <div class="little-label">好奇心，永远在线。</div>
        </div>
        <div class="about-copy" data-reveal>
          <p class="eyebrow">02 / A LITTLE ABOUT ME</p>
          <h2 id="about-title">
            保持好奇，
            <br />
            也保持<span class="accent-italic">笨拙的认真。</span>
          </h2>
          <p>
            21 岁，计算机科学与技术在读。
            <br />
            从电子商务走进代码的世界，
            <br />
            我喜欢让抽象的想法，变成可以被使用的东西。
          </p>
          <p>
            正在向资深计算机开发工程师成长。
            <br />
            既打磨传统技术的基础，也探索新技术的可能。
          </p>
          <div class="toolbox">
            <p class="eyebrow">THINGS I BUILD WITH</p>
            <ul class="stack-list">
              <li>Vue &amp; React</li>
              <li>TypeScript</li>
              <li>Node.js</li>
              <li>AI 应用</li>
              <li>一点点想象力</li>
            </ul>
          </div>
          <a
            class="text-link"
            href="https://github.com/XiaoWuLonely"
            target="_blank"
            rel="noopener noreferrer"
          >
            去 GitHub 看看我的日常 ↗
          </a>
        </div>
      </section>
      <section
        id="journey"
        class="chapter journey"
        aria-labelledby="journey-title"
        data-chapter="经历"
      >
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">03 / NOTES ALONG THE WAY</p>
            <h2 id="journey-title">
              没有捷径，
              <br />
              但沿途<span class="accent-italic">有风景。</span>
            </h2>
          </div>
          <p class="section-aside">
            一些选择，一些尝试。
            <br />
            把走过的路，慢慢连成自己。
            <span>A work, and a self, in progress.</span>
          </p>
        </div>
        <div class="journey-track">
          <svg
            class="journey-path"
            viewBox="0 0 1000 120"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              class="path-guide"
              d="M0 74C150 10 220 120 350 65S560 10 650 66S850 115 1000 40"
            />
            <path
              class="path-drawn"
              d="M0 74C150 10 220 120 350 65S560 10 650 66S850 115 1000 40"
            />
          </svg>
          <ol class="journey-list">
            {journey.map((item) => (
              <li class="journey-stop" data-reveal>
                <span class="journey-year">{item.year}</span>
                <span class="journey-pin" aria-hidden="true"></span>
                <div class="journey-note">
                  <p class="eyebrow">{item.period}</p>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <p class="journey-end">
          下一站，还在书写。<span aria-hidden="true">↗</span>
        </p>
      </section>
      <section
        id="contact"
        class="chapter contact"
        aria-labelledby="contact-title"
        data-chapter="联系"
      >
        <div class="contact-art" aria-hidden="true">
          <Image
            src={contact}
            alt=""
            widths={[600, 1000]}
            sizes="(max-width: 760px) 90vw, 45vw"
            format="webp"
            quality={80}
          />
          <div class="envelope-flap"></div>
        </div>
        <div class="contact-copy" data-reveal>
          <p class="eyebrow">04 / LEAVE A LITTLE NOTE</p>
          <h2 id="contact-title">
            下一段故事，
            <br />
            从一句<span class="accent-italic">你好</span>开始。
          </h2>
          <p>
            关于一个想法、一份机会，或只是打个招呼。
            <br />
            我的信箱，一直为新的连接留着位置。
          </p>
          <a class="contact-email" href="mailto:oolongheist@gmail.com">
            oolongheist@gmail.com <span aria-hidden="true">↗</span>
          </a>
          <div class="contact-actions">
            <button class="text-link copy-email" type="button">
              复制邮箱 <span aria-hidden="true">⧉</span>
            </button>
            <a
              class="text-link"
              href="https://github.com/XiaoWuLonely"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub ↗
            </a>
            <a class="text-link" href="/resume-deng-linfeng.pdf" download>
              下载简历 ↓
            </a>
          </div>
          <p
            id="copy-status"
            class="copy-status"
            role="status"
            aria-live="polite"
          ></p>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <a class="wordmark" href="#home">
        Paper <i>&amp;</i> Pixels.
      </a>
      <p>用代码构建，以好奇心生长。</p>
      <span>© 2026 WULONG</span>
      <a href="#home" class="back-top">
        回到纸张的开头 ↑
      </a>
    </footer>
    <div class="reading-indicator" aria-hidden="true">
      <span class="reading-current">开场</span>
      <span class="reading-line">
        <span></span>
      </span>
      <span>慢慢来，也很好。</span>
    </div>
    <ProjectDialog />
    <script>
      import { initializeUI } from '../scripts/ui';
      import { initializeMotion } from '../scripts/motion';
      const disposeUI = initializeUI();
      const disposeMotion = initializeMotion();
      if (import.meta.hot)
        import.meta.hot.dispose(() => {
          disposeMotion();
          disposeUI();
        });
    </script>
  </body>
</html>
