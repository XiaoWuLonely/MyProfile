---
import { getCollection } from 'astro:content';
import { projectRoles } from '../scripts/story-data';
import JournalStage from './stages/JournalStage.astro';
import KnowledgeStage from './stages/KnowledgeStage.astro';
import FieldStage from './stages/FieldStage.astro';
import AirportStage from './stages/AirportStage.astro';
import FoodStage from './stages/FoodStage.astro';
const stages: Record<string, typeof JournalStage> = {
  myblog: JournalStage,
  knowflow: KnowledgeStage,
  heyue: FieldStage,
  zhifu: AirportStage,
  mcdonalds: FoodStage,
};
const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => {
    const Stage = stages[project.id];
    if (!Stage)
      throw new Error(
        'Every project requires a dedicated paper scene: ' + project.id,
      );
    return { ...project, Stage };
  });
---

<span id="works" aria-hidden="true"></span>

{projects.map(({ id, data, Stage }) => (
  <section
    class:list={['story-panel', 'project-panel', `stage-${id}`]}
    id={`project-${id}`}
    data-story-panel
    data-project={id}
    aria-labelledby={`title-${id}`}
  >
    <Stage />
    <div class="scene-copy">
      <p class="eyebrow">
        PIECE 0{data.order} / {data.category}
      </p>
      <h2 id={`title-${id}`}>{data.title}</h2>
      <p class="project-poem">{data.subtitle}</p>
      <span class="drawn-rule" data-line></span>
      <p class="project-role">{projectRoles[id]}</p>
      <ul class="stack-list">
        {data.stack.slice(0, 3).map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
      <div class="scene-links">
        {data.url && (
          <a
            class="text-link"
            href={data.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            访问作品 ↗
          </a>
        )}
        {data.github && (
          <a
            class="text-link"
            href={data.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        )}
      </div>
    </div>
  </section>
))}
