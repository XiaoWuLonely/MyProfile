<dialog
  id="project-dialog"
  class="project-dialog"
  aria-labelledby="dialog-label"
>
  <div class="dialog-paper">
    <div class="dialog-toolbar">
      <p class="eyebrow" id="dialog-label">
        作品详情
      </p>
      <button type="button" class="dialog-close" aria-label="关闭作品详情">
        关闭 <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="dialog-content"></div>
    <p class="dialog-footnote">
      一件作品，一段正在生长的故事。<span>Paper &amp; Pixels</span>
    </p>
  </div>
</dialog>
